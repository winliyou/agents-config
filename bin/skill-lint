#!/usr/bin/env bash
# skill-lint — 检测 AGENTS.md / skill 知识库中的「已失效」事实与「流水账」写法
#
# 用途：经验沉淀会随项目迭代腐烂。本脚本把「能机器判定」的腐烂类型一次性扫出来，
#       避免 AI 沿用过期事实误导后续工作。
#
# 用法：
#   skill-lint                    # 扫用户级 ~/.agents/skills
#   skill-lint ~/work/foo/.agents/skills
#   skill-lint --all              # 扫用户级 + ~/work 下全部项目级
#   skill-lint --json             # 机器可读输出
#   skill-lint --with-third-party # 连第三方 skill 一起查（默认跳过）
#
# 第三方 skill 默认跳过：它们由上游维护、本地改了会被覆盖，不纳入本地维护范围。
# 判定来源：~/.agents/.third-party-skills 清单 + .skill-lock.json + 上游 frontmatter 特征。
#
# 文档写法：正文日期、变更记录/更新日志/时间线/踩坑记录类章节 = ERROR；
#           变更史式短语（已作废/修复前/旧文…）= WARN。代码块与文件名中的日期除外。
# 归属：用户级 skill 出现项目名或 ~/work 路径 = WARN（项目知识应写项目侧）；
#       项目级 skill 正文无项目锚点 = WARN（确认是否该上提用户级）。
# 退出码：0 = 无 ERROR（可能有 WARN）；1 = 有 ERROR。
set -uo pipefail

MAX_DESC=500          # DSH 目录渲染上限（按「字符」计，非字节）
JSON=0
ALL=0
WITH_THIRD=0
ROOTS=()

for arg in "$@"; do
  case "$arg" in
    --json) JSON=1 ;;
    --all)  ALL=1 ;;
    --with-third-party) WITH_THIRD=1 ;;
    -h|--help) sed -n '2,26p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) ROOTS+=("$arg") ;;
  esac
done

# ---- 载入第三方 skill 名单（bash 3.2 兼容：用换行分隔字符串，不用关联数组）----
THIRD_LIST=""
_tp_file="$HOME/.agents/.third-party-skills"
if [ -f "$_tp_file" ]; then
  THIRD_LIST="$(grep -vE '^[[:space:]]*(#|$)' "$_tp_file" | sed -e 's/[[:space:]]//g' -e '/^$/d')"
fi
_lock="$HOME/.agents/.skill-lock.json"
if [ -f "$_lock" ]; then
  _locked="$(sed -n 's/^    "\([a-z0-9-]*\)": {$/\1/p' "$_lock")"
  THIRD_LIST="$(printf '%s\n%s\n' "$THIRD_LIST" "$_locked" | sed '/^$/d')"
fi

# 上游 frontmatter 特征：metadata.author / license: / argument-hint:
is_third_party() {
  local dir="$1" name
  name="$(basename "$dir")"
  printf '%s\n' "$THIRD_LIST" | grep -qx -- "$name" && return 0
  local f="$dir/SKILL.md"
  [ -f "$f" ] || return 1
  awk 'NR==1{next} /^---$/{exit} {print}' "$f" \
    | grep -qE '^  author:|^license:|^argument-hint:' && return 0
  return 1
}

if [ "$ALL" -eq 1 ]; then
  ROOTS+=("$HOME/.agents/skills")
  while IFS= read -r d; do ROOTS+=("$d"); done < <(find "$HOME/work" -maxdepth 5 -type d -path "*/.agents/skills" \
      -not -path "*/node_modules/*" -not -path "*/.worktrees/*" -not -path "*/.agents/worktrees/*" -not -path "*/.workwork/*" 2>/dev/null | sort -u)
fi
[ ${#ROOTS[@]} -eq 0 ] && ROOTS=("$HOME/.agents/skills")

# ---- 本机项目名（归属检查用：用户级 skill 不得绑定具体项目）----
WORK_NAMES=""
while IFS= read -r _wd; do
  _wb="$(basename "$_wd")"
  case "$_wb" in .*) continue ;; esac
  WORK_NAMES="$WORK_NAMES$_wb"$'\n'
done < <(find "$HOME/work" -maxdepth 1 -mindepth 1 -type d 2>/dev/null)

errors=0
warns=0
skipped=0
emit() {
  if [ "$JSON" -eq 1 ]; then
    printf '{"level":"%s","skill":"%s","message":"%s"}\n' "$1" "$2" "$3"
  else
    printf '%-5s %-30s %s\n' "$1" "$2" "$3"
  fi
  if [ "$1" = "ERROR" ]; then errors=$((errors+1)); else warns=$((warns+1)); fi
}

# ---- 文档写法检查：日期与变更史章节是 ERROR；叙事式短语是 WARN ----
doc_check() {
  local file="$1" label="$2" with_phrases="$3" hit
  while IFS= read -r hit; do
    [ -z "$hit" ] && continue
    emit ERROR "$label" "正文含日期标注（只写现状，历史交给 git）：$hit"
  done < <(awk 'BEGIN{fence=0}
    /^[[:space:]]*```/ {fence=!fence; next}
    fence {next}
    /20[0-9][0-9][-年][0-9]/ {
      if ($0 ~ /20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[A-Za-z]/) next
      print FILENAME":"FNR" | "substr($0,1,70)
    }' "$file" 2>/dev/null)
  while IFS= read -r hit; do
    [ -z "$hit" ] && continue
    emit ERROR "$label" "存在变更记录/更新日志/时间线/踩坑记录类章节：$hit"
  done < <(awk 'BEGIN{fence=0}
    /^[[:space:]]*```/ {fence=!fence; next}
    fence {next}
    /^#{1,6}[[:space:]]/ && /(变更记录|更新记录|更新日志|版本历史|修订记录|时间线|历史记录|事故复盘|踩坑记录)/ {
      print FILENAME":"FNR" | "substr($0,1,70)
    }' "$file" 2>/dev/null)
  if [ "$with_phrases" = "1" ]; then
    while IFS= read -r hit; do
      [ -z "$hit" ] && continue
      emit WARN "$label" "含变更史式表述（改写成现状）：$hit"
    done < <(grep -nE '已作废|已废弃|旧文|修复前|修复后|变更记录|更新记录|版本历史|历史遗留|踩坑记录|事故复盘|上一轮|本次修改|本次更新|本文新增' "$file" 2>/dev/null | sed "s#^#$file:#" | cut -c1-160)
  fi
}

declare -a ALL_NAMES=()
for root in "${ROOTS[@]}"; do
  [ -d "$root" ] || continue
  while IFS= read -r d; do ALL_NAMES+=("$(basename "$d")"); done < <(find "$root" -maxdepth 1 -mindepth 1 -type d 2>/dev/null)
done

for root in "${ROOTS[@]}"; do
  [ -d "$root" ] || { emit WARN "(root)" "目录不存在，跳过：$root"; continue; }
  for dir in "$root"/*/; do
    [ -d "$dir" ] || continue
    f="$dir/SKILL.md"
    name="$(basename "$dir")"
    [ -f "$f" ] || { emit ERROR "$name" "缺少 SKILL.md"; continue; }

    # ---- 0. 第三方 skill 默认跳过（上游维护，本地改了会被覆盖；不纳入本地维护范围）
    if [ "$WITH_THIRD" -eq 0 ] && is_third_party "$dir"; then
      if [ "$JSON" -eq 1 ]; then
        printf '{"level":"SKIP","skill":"%s","message":"第三方 skill，未纳入本地维护"}\n' "$name"
      else
        printf '%-5s %-30s %s\n' SKIP "$name" "第三方 skill，未纳入本地维护"
      fi
      skipped=$((skipped+1))
      continue
    fi

    # ---- 1. frontmatter 完整性（缺 name/description 会被 DSH 静默忽略 = skill 消失）
    if ! head -1 "$f" | grep -qx -- '---'; then
      emit ERROR "$name" "首行不是 ---，无 frontmatter（DSH 会静默忽略该 skill）"
    else
      fm=$(awk 'NR==1{next} /^---$/{exit} {print}' "$f")
      printf '%s\n' "$fm" | grep -q '^name:'        || emit ERROR "$name" "frontmatter 缺 name"
      printf '%s\n' "$fm" | grep -q '^description:' || emit ERROR "$name" "frontmatter 缺 description"
    fi

    # ---- 1b. frontmatter 里未加引号的标量含 ": " → YAML 解析失败，skill 被 DSH 静默忽略
    #      （description 写了 "websites: navigating" 会让该 skill 从目录消失）
    while IFS= read -r bad; do
      [ -z "$bad" ] && continue
      emit ERROR "$name" "frontmatter 的 $bad 值含未加引号的 ': '，YAML 解析会失败导致 skill 被静默忽略（加引号即可）"
    done < <(python3 - "$f" << 'PYEOF'
import sys, re
path = sys.argv[1]
try:
    text = open(path, encoding="utf-8").read()
except Exception:
    raise SystemExit
m = re.match(r"^---\r?\n(.*?)\r?\n---", text, re.S)
if not m:
    raise SystemExit
for line in m.group(1).split("\n"):
    hit = re.match(r"^(name|description|whenToUse):\s*(.*)$", line)
    if not hit:
        continue
    val = hit.group(2).strip()
    if not val:
        continue
    if val[0] in ("\"", chr(39)):
        continue
    if ": " in val or val.endswith(":"):
        print(hit.group(1))
PYEOF
    )

    # ---- 2. description 长度（按字符计；超 500 会被 DSH 截断成 "..."，尾部触发词丢失）
    dlen=$(python3 - "$f" <<'PYEOF'
import sys, re
path = sys.argv[1]
try:
    text = open(path, encoding="utf-8").read()
except Exception:
    print(0); raise SystemExit
m = re.match(r"^---\r?\n(.*?)\r?\n---", text, re.S)
if not m:
    print(0); raise SystemExit
lines = m.group(1).split("\n")
idx = next((i for i, l in enumerate(lines) if l.startswith("description:")), None)
if idx is None:
    print(0); raise SystemExit
val = lines[idx][len("description:"):].strip()
for nxt in lines[idx+1:]:
    if nxt[:1].isspace() and nxt.strip():
        val += " " + nxt.strip()
    else:
        break
val = val.strip().strip('"').strip("'")
print(len(re.sub(r"\s+", " ", val).strip()))
PYEOF
)
    if [ "${dlen:-0}" -gt "$MAX_DESC" ]; then
      emit ERROR "$name" "description ${dlen} 字符 > ${MAX_DESC}，目录里会被截断，尾部触发词丢失"
    fi

    # ---- 3. 正文里出现的本机绝对路径是否真实存在（含反引号与裸文本两种写法）
    #      例外：同行在陈述「不存在/未配置/未设置」，属正确描述，不算失效。
    while IFS= read -r p; do
      [ -z "$p" ] && continue
      # 跳过模板占位符与「路径:行号」写法
      case "$p" in *'<'*|*'>'*|*'*'*|*'{'*|*'}'*) continue ;; esac
      if printf '%s' "$p" | grep -qE ':[0-9]+(-[0-9]+)?$'; then continue; fi
      ep="${p/#\~/$HOME}"
      ep="${ep/#\$HOME/$HOME}"
      [ -e "$ep" ] && continue
      # 裸 token 可能是「含空格路径」被截断的前缀：若存在以此开头的真实条目则不算失效
      if compgen -G "${ep}*" >/dev/null 2>&1; then continue; fi
      # 豁免 1：同行在陈述「不存在/未配置」，属正确描述
      if grep -F -- "$p" "$f" 2>/dev/null | grep -qE '不存在|未配置|未设置|未安装|尚未|not exist'; then
        continue
      fi
      # 豁免 2：远端/运行时产物——路径在服务器上、或由程序运行时生成，本机本来就没有
      if grep -F -- "$p" "$f" 2>/dev/null | grep -qE '服务器|远端|远程|运行时|自动生成|首次运行|运行后|示例|例如|比如'; then
        continue
      fi
      emit WARN "$name" "引用的路径不存在：$p"
    done < <(
      {
        # ① 反引号包裹的整段路径（允许含空格，如 "~/Library/Application Support/go"）
        grep -ohE '\`(~|\$HOME)/[^\`]+\`' "$f" 2>/dev/null | tr -d '\`' | sed -E 's/ +--?[A-Za-z].*$//' | sed 's/[.,):;、）]*$//'
        # ② 裸文本路径（遇到空格即止，避免把 "~/Library/Application Support" 截成 "~/Library/Application"）
        grep -ohE '(~|\$HOME)/[A-Za-z0-9_./-]+' "$f" 2>/dev/null | sed 's/[.,):;、）]*$//'
      } | sort -u
    )

    # ---- 3b. 相对路径式调用 .agents/skills/...（按 cwd 解析，通常在本项目根之外跑不通）
    if grep -qE '(^|[^/\w])\.agents/skills/' "$f" 2>/dev/null; then
      emit WARN "$name" "使用了相对路径 .agents/skills/...（依赖 cwd，跨项目调用会失败；建议改绝对路径）"
    fi

    # ---- 4. 交叉引用的 skill 名是否存在
    while IFS= read -r ref; do
      [ -z "$ref" ] && continue
      [ "$ref" = "$name" ] && continue
      found=0
      for n in "${ALL_NAMES[@]}"; do if [ "$n" = "$ref" ]; then found=1; break; fi; done
      [ "$found" -eq 0 ] && emit WARN "$name" "引用了不存在的 skill：$ref"
    done < <(grep -ohE '(skill|skills) \`[a-z][a-z0-9-]+\`' "$f" 2>/dev/null | sed -E 's/.*\`([a-z0-9-]+)\`/\1/' | sort -u)

    # ---- 5. 文档写法检查：日期 / 变更史章节 / 变更史短语（只写现状，历史交给 git）
    #      写法规范自身（knowledge-maintenance）必然引用反例词，跳过短语告警
    phrases=1
    [ "$name" = "knowledge-maintenance" ] && phrases=0
    doc_check "$f" "$name" "$phrases"
    for ref in "$dir"references/*.md; do
      [ -f "$ref" ] && doc_check "$ref" "$name" "$phrases"
    done

    # ---- 5b. 归属检查：默认项目侧；用户级 skill 不得绑定具体项目 ----
    #      lint 只能抓显式痕迹（项目名/路径）；「已泛化但仍是单项目架构」需人工判断。
    case "$root" in
      "$HOME/.agents/skills"|"$HOME/.dsh/skills")
        if [ "$name" != "local-environment" ]; then
          for chk in "$f" "$dir"references/*.md; do
            [ -f "$chk" ] || continue
            while IFS= read -r hit; do
              [ -z "$hit" ] && continue
              emit WARN "$name" "用户级 skill 出现项目工作区路径（项目知识应写项目侧）：$hit"
            done < <(grep -nE '(~|\$HOME)/work/|/Users/[^/]+/work/' "$chk" 2>/dev/null | grep -v '<' | cut -c1-120)
            while IFS= read -r pn; do
              [ -z "$pn" ] && continue
              [ ${#pn} -lt 5 ] && continue
              hit=$(grep -nE "(^|[^A-Za-z0-9_.-])${pn}([^A-Za-z0-9_-]|$)" "$chk" 2>/dev/null | head -1 | cut -c1-120)
              [ -n "$hit" ] && emit WARN "$name" "用户级 skill 出现项目名「$pn」（项目知识应写项目侧）：$hit"
            done <<< "$WORK_NAMES"
          done
        fi
        ;;
      *)
        # 项目级：正文既无项目名也无项目内真实路径 → 可能该上提用户级
        proj="$(dirname "$(dirname "$root")")"
        pname="$(basename "$proj")"
        anchor=0
        grep -qiF -- "$pname" "$f" 2>/dev/null && anchor=1
        if [ "$anchor" -eq 0 ]; then
          # 项目顶层条目名也算锚点（排除 docs/src 之类通用目录名，避免误判）
          while IFS= read -r _e; do
            _b="$(basename "$_e")"
            case " docs doc src lib libs test tests scripts script public assets config configs cmd internal pkg web frontend backend node_modules bin deploy dist api app apps examples example README.md AGENTS.md CHANGELOG.md LICENSE package.json Makefile " in *" $_b "*) continue ;; esac
            [ ${#_b} -ge 4 ] || continue
            grep -qF -- "$_b" "$f" 2>/dev/null && { anchor=1; break; }
          done < <(find "$proj" -maxdepth 1 -mindepth 1 -not -name '.*' 2>/dev/null)
        fi
        if [ "$anchor" -eq 0 ]; then
          while IFS= read -r tok; do
            [ -z "$tok" ] && continue
            t="${tok#./}"
            case "$t" in *'<'*|*'>'*|*'*'*|*'--'*|*' '*) continue ;; esac
            if [ -e "$proj/$t" ] || [ -e "$proj/${t%%/*}" ]; then anchor=1; break; fi
          done < <(grep -ohE '\`[^\`]+\`' "$f" 2>/dev/null | tr -d '\`' | sed 's/[.,:;()（）「」]*$//' | sort -u)
        fi
        [ "$anchor" -eq 0 ] && emit WARN "$name" "项目级 skill 未出现本项目名或项目内真实路径（确认是否该上提用户级）"
        ;;
    esac

  done
done

# ---- 7. AGENTS.md 文档写法检查（全局始终检查；--all 额外覆盖项目 AGENTS.md）
doc_check "$HOME/.agents/AGENTS.md" "(agents)" 0
if [ "$ALL" -eq 1 ]; then
  while IFS= read -r ag; do
    [ -f "$ag" ] || continue
    doc_check "$ag" "(agents)" 0
  done < <(find "$HOME/work" -maxdepth 3 -name 'AGENTS.md'       -not -path '*/node_modules/*' -not -path '*/.git/*' -not -path '*/.worktrees/*' -not -path '*/.agents/worktrees/*' -not -path '*/.workwork/*' 2>/dev/null | sort -u)
fi

# ---- 6. 孤儿 skill：项目级 skill 未被项目 AGENTS.md 索引（AI 很难发现它）
#      用户级 skill 由 DSH 自动发现挂载，不需要索引，故跳过。
for root in "${ROOTS[@]}"; do
  [ -d "$root" ] || continue
  case "$root" in
    "$HOME/.agents/skills"|"$HOME/.dsh/skills") continue ;;
  esac
  proj="$(dirname "$(dirname "$root")")"
  ag="$proj/AGENTS.md"
  if [ ! -f "$ag" ]; then emit WARN "(index)" "无项目 AGENTS.md，skill 无索引入口：$root"; continue; fi
  for dir in "$root"/*/; do
    [ -d "$dir" ] || continue
    n="$(basename "$dir")"
    # 索引口径：项目根下任意 Markdown（AGENTS.md / RELEASING.md / README.md …）提到即算有入口
    # 索引口径：项目根顶层 Markdown + 任意层 AGENTS.md（覆盖 RELEASING.md / README.md / 子目录 AGENTS.md）
    if grep -qF -- "$n" "$proj"/*.md 2>/dev/null        || find "$proj" -maxdepth 4 -name 'AGENTS.md' -not -path '*/node_modules/*'             -not -path '*/.git/*' -not -path '*/.worktrees/*' -not -path '*/.agents/worktrees/*' -not -path '*/.workwork/*'             -exec grep -qF -- "$n" {} + 2>/dev/null; then
      continue
    fi
    emit WARN "$n" "孤儿 skill：项目内任何 Markdown 都未提及（AI 很难发现它）"
  done
done

if [ "$JSON" -eq 0 ]; then
  printf '\n合计：ERROR=%d  WARN=%d  SKIP(第三方)=%d\n' "$errors" "$warns" "$skipped"
fi
if [ "$errors" -gt 0 ]; then exit 1; else exit 0; fi

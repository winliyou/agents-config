#!/usr/bin/env bash
# skill-new — 按规范生成 skill 骨架（只建目录与 SKILL.md，正文需人工补齐）
set -uo pipefail

usage() {
  echo "用法: skill-new <skill-name> [skills 目录]"
  echo "默认目录: ~/.agents/skills"
  echo "生成后需填写 description 触发词与正文规则/命令/验证，再跑 skill-lint。"
}

[ $# -ge 1 ] || { usage; exit 1; }
name="$1"
root="${2:-$HOME/.agents/skills}"
tpl="$HOME/.agents/skills/knowledge-maintenance/templates/SKILL.md"

case "$name" in
  ''|*[!a-z0-9-]*|[0-9-]*|*-) echo "skill 名必须小写字母开头，只含小写字母/数字/连字符"; exit 1 ;;
esac
[ -f "$tpl" ] || { echo "模板不存在: $tpl"; exit 1; }
[ -d "$root" ] || { echo "目录不存在: $root"; exit 1; }
dest="$root/$name"
[ -e "$dest" ] && { echo "已存在: $dest"; exit 1; }

mkdir -p "$dest"
sed -e "s/{{name}}/$name/g" -e "s/{{标题}}/$name/g" "$tpl" > "$dest/SKILL.md"
echo "已创建: $dest/SKILL.md"
echo "下一步: 填 description 触发词与正文，然后跑 skill-lint（ERROR 必须为 0）。"
